# ─── Gemini AI configuration (server-side only) ───────────────────────────
# SafeFlow AI uses Google's Gemini API for AI features. All keys are read
# server-side only — they are never exposed to the browser.
#
# Configure at least GEMINI_API_KEY. Additional numbered keys act as
# fallbacks if the primary key is invalid, revoked, or the service returns
# a transient error. The manager tries keys in order and skips any key
# that returns a 400/401/403 for 5 minutes.
#
# Quota / rate-limit (429) responses do NOT trigger key rotation — the
# manager returns a temporary-unavailability result instead, per Google's
# terms of service.
#
# Get your API keys from: https://aistudio.google.com/apikey


GEMINI_API_KEY=AQ.Ab8RN6L-4P67X7ykqRdo4k09ZwZtUTDFHwi6rWrgOE5hE32quw
GEMINI_API_KEY_2=AIzaSyDvIhdOBp0B5WmTif1IdNI3Igo48QooEL8
GEMINI_API_KEY_3=AIzaSyCShLoYqYfoUiDYchqTjENk1I6TZFzAIO4
